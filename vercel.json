{
  "version": 2,
  "builds": [
    {
      "src": "datahome-landing/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "api/leads.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/leads",
      "dest": "/api/leads"
    },
    {
      "src": "/(.*)",
      "dest": "/datahome-landing/$1"
    }
  ]
}
