# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# URL of your deployed Google Apps Script web app.
# Get it from: Apps Script > Deploy > Manage deployments > copy the web app URL.
GAS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec

# Shared secret between this server and the GAS script.
# Generate a random string: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set the same value in gas-webhook.gs > WEBHOOK_SECRET variable.
WEBHOOK_SECRET=replace-with-a-random-string
