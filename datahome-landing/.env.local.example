# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.

# Resend API key — same key used in habihub-light-template
RESEND_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email sender (must be a verified domain in Resend)
FROM_EMAIL=noreply@data-home.app

# Contact email recipients (comma-separated)
CONTACT_EMAIL=gaetan@amaru-homes.com

# Absolute API URL used by static pages (index.html)
NEXT_PUBLIC_API_URL=https://data-home-light-landing.vercel.app
